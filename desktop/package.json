{
  "name": "llm-live2d-desktop",
  "version": "1.0.0",
  "description": "Live2D AI 桌宠",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.llm-live2d.desktop",
    "productName": "LLM Live2D",
    "files": [
      "main.js",
      "preload.js",
      "pet.html",
      "../frontend/public/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
